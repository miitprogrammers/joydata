# GEMINI_API_KEY: Gemini API key for the Smart Report AI resume (server only, never sent to the browser).
# The Google project behind the key needs billing (paid tier): the free tier may use prompts to improve
# Google's products, and some projects are refused on it.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# GEMINI_MODEL: optional, defaults to gemini-2.5-flash (falls back to gemini-flash-lite-latest).
# GEMINI_MODEL="gemini-2.5-flash"

# OPENROUTER_API_KEY: optional backup for the Smart Report resume, used when Gemini is overloaded or failing.
# Free models may log prompts; the resume facts carry no names, but keep the OpenRouter privacy settings in mind.
# OPENROUTER_API_KEY=""
# OPENROUTER_MODEL: optional, defaults to openrouter/free (routes to an available free model).
# OPENROUTER_MODEL="openrouter/free"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Database Internal - Supabase
supabase_url="https://your-project-ref.supabase.co"
supabase_key="YOUR_SUPABASE_PUBLISHABLE_KEY"
# Direkomendasikan untuk backend Express (melewati RLS) atau koneksi SQL langsung (pg):
SUPABASE_SECRET_KEY="YOUR_SUPABASE_SECRET_OR_SERVICE_ROLE_KEY"
DATABASE_URL="postgresql://postgres.your-project-ref:YOUR_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# Database Eksternal - MySQL Mancation (Read-Only)
host_name="YOUR_MYSQL_HOST"
db_name="YOUR_MYSQL_DB_NAME"
db_user="YOUR_MYSQL_USER"
db_password="YOUR_MYSQL_PASSWORD"
JOY_MANCATION_CLASS_IDS="139,142,144"

# Autentikasi Internal Staff (JWT)
JWT_SECRET="YOUR_JWT_SECRET"
JWT_REFRESH_SECRET="YOUR_JWT_REFRESH_SECRET"

# Web Push Notification (VAPID) & Jadwal Pengingat
VAPID_PUBLIC_KEY="YOUR_VAPID_PUBLIC_KEY"
VAPID_PRIVATE_KEY="YOUR_VAPID_PRIVATE_KEY"
VAPID_SUBJECT="mailto:admin@example.com"
CRON_SECRET="YOUR_CRON_SECRET"

# Data contoh (demo). Set "false" untuk memulai dengan data kosong.
# Saat "false", store baru hanya berisi role, halaman, akses, akun admin, settings,
# program, dan kategori sikap — tanpa staf/kelas/peserta/nilai/absensi contoh.
# Jalankan `npm run reset:data` untuk membersihkan store yang sudah ada.
JOY_SEED_DEMO="true"

